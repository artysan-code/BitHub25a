# Obsidian — la config del vault è personale di ciascuno: non versionata
.obsidian/
.trash/

# File temporanei e backup
*.tmp
*.bak
~$*
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Pianificazione e stato personale dello studente — restano fuori dalla repo.
# Pattern generico: qualunque "Piano ....md" (di studi, esame, orale, ripasso...)
# è coperto senza doverlo aggiungere qui volta per volta.
Piano *.md
Situazione Universitaria.md

# Materiale di studio pesante / protetto — tenere solo in locale, mai su GitHub
# (PDF di libri di testo, scansioni, estratti OCR grezzi: peso eccessivo + copyright)
Estratti/

# Hackathon Oracle — repository git indipendente nidificata, gestita a sé
/Hackathons/Oracle 2025-2026/

# File sorgente Xournal++ — committare solo l'export PDF
*.xopp

# Artefatti rigenerabili — ambienti e cache Python degli esercizi
.venv/
__pycache__/
*.pyc
*.pyo

# Binari compilati dagli esercizi C/C++/Java (rigenerabili dal sorgente)
a.out
*.o
*.class
*.exe

# Build front-end (es. esperimenti hackathon fuori dalla cartella Oracle)
dist/
build/

# Archivi binari — estrarre e versionare i singoli file utili, non lo zip
*.zip

# Artefatti di compilazione LaTeX (i sorgenti .tex restano versionati)
*.aux
*.synctex.gz
*.fls
*.fdb_latexmk

# Secrets — mai committare credenziali, chiavi, wallet, token
*credentials*
*.pem
*.key
*.keystore
.env
.env.*
*.wallet
*secret*
*.token
